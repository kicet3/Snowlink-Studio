+# Snowfall integration: all LLM calls go through the local GPT/Grok OAuth bridge.
+# Credentials remain in ima2's existing session stores, never in ShortGPT's database.
+def llm_completion(chat_prompt="", system="", temp=0.7, max_tokens=2000,
+                   remove_nl=True, conversation=None):
+    import urllib.request
+    import urllib.parse
+    endpoint = os.environ.get("SNOWFALL_AI_URL", "http://127.0.0.1:3400/v1/chat/completions")
+    parsed = urllib.parse.urlsplit(endpoint)
+    if parsed.scheme != "http" or parsed.hostname not in ("127.0.0.1", "localhost"):
+        raise ValueError("SNOWFALL_AI_URL must be a local HTTP bridge")
+    provider = os.environ.get("SNOWFALL_AI_PROVIDER", "studio-default")
+    if provider not in ("studio-default", "gpt-oauth", "grok-oauth"):
+        raise ValueError("Choose studio-default, gpt-oauth, or grok-oauth")
+    messages = conversation or [
+        {"role": "system", "content": system},
+        {"role": "user", "content": chat_prompt},
+    ]
+    request = urllib.request.Request(endpoint,
+        data=json.dumps({"model": provider, "messages": messages, "stream": False}).encode(),
+        headers={"Content-Type": "application/json"}, method="POST")
+    with urllib.request.urlopen(request, timeout=135) as response:
+        result = json.load(response)
+    text = result["choices"][0]["message"]["content"].strip()
+    return re.sub(r"\s+", " ", text) if remove_nl else text
