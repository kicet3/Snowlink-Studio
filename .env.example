# SNS 공식 API / 계정 연동 설정입니다.
# 서버는 Google 자격증명과 META_APP_ID/SECRET을 읽습니다. 변경 후 재시작 필요.
# 이미 .env가 있으면 덮어쓰지 말고 필요한 빈 항목만 직접 채우세요.
# Google OAuth·내 YouTube 채널 조회를 지원합니다. Instagram 계정 OAuth와 X 연동은 준비 중입니다.
# 현재 앱 실행에는 필수가 아니며, 연결할 플랫폼의 항목만 준비합니다.
# GPT·Grok은 설정 화면에서 OAuth 로그인하므로 AI API 키는 넣지 않습니다.

# YouTube 공개 영상 검색·통계용 준비 항목 (현재 검색기는 이 키를 사용하지 않음)
YOUTUBE_API_KEY=

# 내 YouTube 채널 연결·조회 (웹 애플리케이션 OAuth 클라이언트)
# 승인된 리디렉션 URI: http://localhost:3400/api/google/oauth/callback
# 다른 접속 주소는 설정 · OAuth → 내 YouTube 채널 → Google 앱 설정에서 확인합니다.
# GOOGLE_REDIRECT_URI는 필요하지 않습니다. 허용된 접속 주소에서 자동 결정합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Instagram 계정 연결용 Meta 앱 (Facebook Login 경로)
# 서버 전용이며 상태 API/화면에는 값이 노출되지 않습니다. 변경 후 서버 재시작 필요.
# MCP 로그인 토큰이나 Instagram 계정 토큰을 넣지 마세요.
META_APP_ID=
META_APP_SECRET=

# X 공개 게시물 조회 (앱 전용 Bearer Token)
X_BEARER_TOKEN=
